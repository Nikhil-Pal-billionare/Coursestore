# Supabase - get these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay - get these from Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Resend (for payout-held emails) - optional, skip for now if not ready
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=CourseMarket <onboarding@resend.dev>

# A random secret string you make up yourself - protects the /api/cron/*
# routes so only Vercel's cron scheduler (which sends this as a Bearer
# token) can trigger them. Generate any long random string.
CRON_SECRET=your-random-secret-string-here
